FROM node:22-bookworm-slim AS node
FROM mcr.microsoft.com/dotnet/sdk:10.0.100
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/python
COPY platform/requirements.txt /opt/requirements.txt
RUN /opt/python/bin/pip install --require-hashes -r /opt/requirements.txt
ENV PATH="/opt/python/bin:${PATH}" PYTHONPATH=/opt/platform NUGET_PACKAGES=/opt/nuget \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 NG_CLI_ANALYTICS=false
COPY templates /opt/templates
WORKDIR /opt/templates/dotnet-api
RUN dotnet restore Generated.slnx --locked-mode
WORKDIR /opt/node-deps
COPY templates/angular-admin/package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY platform/app /opt/platform/app
COPY infra/runner/RunnerContractTests.cs /opt/runner/RunnerContractTests.cs
RUN chmod -R a+rX /opt && mkdir /work && chmod 777 /work
WORKDIR /work
ENTRYPOINT ["python", "-m", "app.runner.sandbox"]
