# Factory belongs to the team's integration module: def create_runtime(settings) -> Runtime
# RWB_RUNTIME_FACTORY=app.integrations:create_runtime
RWB_GENERATED_ROOT=../generated
RWB_TEMPLATES_ROOT=../templates
RWB_RUN_TIMEOUT_SECONDS=900
RWB_HEARTBEAT_SECONDS=10
RWB_STALE_SECONDS=60
RWB_POLL_SECONDS=2
# JSON array, restrict to the actual demo frontend origin.
RWB_CORS_ORIGINS=["http://localhost:4200"]
