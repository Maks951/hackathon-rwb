# Factory belongs to the team's integration module: def create_runtime(settings) -> Runtime
RWB_RUNTIME_FACTORY=app.integrations.database_runtime:create_runtime
RWB_GENERATED_ROOT=../generated
RWB_TEMPLATES_ROOT=../templates
RWB_RUN_TIMEOUT_SECONDS=900
RWB_HEARTBEAT_SECONDS=10
RWB_STALE_SECONDS=60
RWB_POLL_SECONDS=2
# JSON array, restrict to the actual demo frontend origin.
RWB_CORS_ORIGINS=["http://localhost:4200"]

DATABASE_URL=postgresql+psycopg://platform:platform_local@localhost:5432/platform
# Local-only demo value; choose a separate password for the shared VM.
POSTGRES_PASSWORD=platform_local

# Qwen OpenAI-compatible endpoint. Use the exact values supplied by organizers.
# Never commit real credentials. Example path only; confirm provider API compatibility.
QWEN_BASE_URL=
QWEN_API_PATH=/chat/completions
QWEN_MODEL=
QWEN_API_KEY=

# Enable only for Qwen reached through a trusted host SSH tunnel.
QWEN_ALLOW_DOCKER_HOST_HTTP=false

# Enable only on VM for the exact internal http://10.10.10.10:4000/v1 endpoint.
QWEN_ALLOW_VM_HTTP=false
# A separate random token shared only by worker and trusted Docker broker (32+ chars).
RWB_RUNNER_TOKEN=
RWB_RUNNER_TIMEOUT_SECONDS=600
# Full pipeline may include three validation attempts.
